{
  "description": "TravianZ game server",
  "license": "GPL-3.0-or-later",
  "name": "travianz/travianz",
  "type": "project",
  "require": {
    "php": "^8.4",
    "twig/twig": "^3.8"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.63",
    "rector/rector": "^1.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "GameEngine/Security.php"
    ]
  },
  "scripts": {
    "analyse": "phpstan analyse -c phpstan.neon",
    "analyse:legacy": "phpstan analyse -c phpstan-legacy.neon --memory-limit=1G",
    "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
    "cs:fix": "php-cs-fixer fix --ansi",
    "lint:php": "php tools/php-lint.php",
    "qa": [
      "@lint:php",
      "@analyse",
      "@analyse:legacy",
      "@cs:check",
      "@rector:dry",
      "@test"
    ],
    "rector:dry": "rector process --dry-run",
    "rector:fix": "rector process"
    ,
    "test": "vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
